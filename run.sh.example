#!/usr/bin/env bash
# Copy to run.sh, fill in real values, and `chmod +x run.sh`.
# Never commit run.sh with real secrets.
set -euo pipefail

cd "$(dirname "$0")"

export SFTP_HOST="ftp.server.com"
export SFTP_PORT="22"
export SFTP_USER="user"
export SFTP_PASSWORD="your_sftp_password"
export SFTP_REMOTE_DIR="/home/user/server.com/path"

# Optional: where MT5 CSVs are written locally (defaults to the Wine Documents dir)
# export LOCAL_MT5_DIR="/home/ubuntu/.wine/drive_c/users/ubuntu/Documents"

if ! command -v wine >/dev/null 2>&1; then
    echo "ERROR: wine is not installed. Install it (sudo apt install wine) and run" >&2
    echo "       scripts/setup_wine_python.sh once to install Windows Python." >&2
    exit 1
fi

# MetaTrader5 is Windows-only: use the Windows Python installed inside Wine
# (see scripts/setup_wine_python.sh). Do NOT use `wine python`.
WINE_PYTHON_EXE="${WINE_PYTHON_EXE:-C:\\Python311\\python.exe}"

exec wine "$WINE_PYTHON_EXE" mt5_ohlcv_exporter.py "$@"
